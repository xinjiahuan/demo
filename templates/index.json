        "yg_text_item_QGJykF": {
            "type": "yg-text-item",
            "blocks": {
                "item_TjMYVj": {
                    "type": "item",
                    "settings": {
                        "title": "Strategize Smarter",
                        "content": "<p><strong>No fluff. Just focused, data-backed plans.<\/strong><br\/>With a challenger mindset and deep audits, we set clear goals and carve out your fastest path to growth.<br\/><br\/><\/p><ul><li>Brand & Market Audit<\/li><li>Benchmark & Incremental Growth Path<\/li><li>Strategical Media Plan<br\/><\/li><\/ul>",
                        "font_size": 15,
                        "font_size_mobile": 14
                    }
                },
                "item_bn48ad": {
                    "type": "item",
                    "disabled": true,
                    "settings": {
                        "title": "Create what Converts",
                        "content": "<p><strong>Not just pretty content--performance content. <\/strong><br\/>Content production is also data science. Every asset we make is backed by millions of creative analysis<br\/><br\/><\/p><ul><li>Massive Content Analysis<\/li><li>aQuality Creative Production<br\/><\/li><\/ul>",
                        "font_size": 15,
                        "font_size_mobile": 14
                    }
                },
                "item_iPBDaB": {
                    "type": "item",
                    "settings": {
                        "title": "Create what Converts",
                        "content": "<p><strong>Not just pretty content--performance content. <\/strong><br\/>Content production is also data science. Every asset we make is backed by millions of creative analysis<br\/><br\/><\/p><ul><li>Massive Content Analysis<\/li><li>Quality Creative Production<br\/><\/li><\/ul>",
                        "font_size": 15,
                        "font_size_mobile": 14
                    }
                },
                "item_wDtPBP": {
                    "type": "item",
                    "settings": {
                        "title": "Smart Order Management",
                        "content": "<p><strong>Measure that Matters Thrive on social, don't just survive. <\/strong><br\/>With a challenger mindset and deep audits, we set clear goals and carve out your fastest path to growth.<br\/><br\/><\/p><ul><li> Real-time Ad Campaign Optimization <\/li><li>Amplify Success with Data<br\/><\/li><\/ul>",
                        "font_size": 15,
                        "font_size_mobile": 14
                    }
                }
            },
