        {% if image_blocks.size > 0 %}
          <div class="yg-content-image-list">
            {% for image_block in image_blocks %}
              {% if image_block.settings.image != blank %}
                <div class="yg-content-image-item">
                  {% render 'yg-image', img: image_block.settings.image %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        {% if video_blocks.size > 0 %}
          <yg-content-video-list class="yg-content-video-list swiper">
            <div class="swiper-wrapper">
              {% for video_block in video_blocks %}
                {% if video_block.settings.video != blank %}
                  <div class="swiper-slide">
                    <div class="yg-content-video-container">
                      {% if section.settings.logo_image != blank %}
                        <div class="yg-content-video-logo-container">
                          <img src="{{ section.settings.logo_image | image_url: width: 100 }}" alt="" class="yg-content-video-logo">
                        </div>
                      {% endif %}
                      <img src="{{ 'iphone.png' | asset_url }}" alt="" class="yg-content-video-mask">
                      {% render 'media',
                        media: video_block.settings.video,
                        poster: video_block.settings.image,
                        autoplay: false,
                        muted: true,
                        loop: true,
                        class: 'yg-content-video',
                        style: ''
                      %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
              {% if video_blocks.size < 8 %}
                {% for video_block in video_blocks %}
                  {% if video_block.settings.video != blank %}
