<style>
  #shopify-section-{{ section.id }} .container {
    {% if section.settings.enable_custom_padding %}
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% endif %}
  }


  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .container {
      {% if section.settings.enable_custom_padding %}
        padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .yg-background-image {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .yg-background-image + .color-scheme {
    background: transparent;
  }

  #shopify-section-{{ section.id }} .section-content {
    display: grid;
    grid-template-columns: 100%;
    gap: 80px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .section-content .yg-content-data-list {
    display: grid;
    grid-template-columns: repeat(min(var(--num), 4), 1fr);
    gap: 80px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .section-content .yg-content-data {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .section-content .yg-gmv-header {
    display: grid;
    grid-template-columns: 36px auto 36px;
    gap: 12px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .section-content .yg-gmv-amount {
    font-size: 30px;
    font-weight: bold;
    background: linear-gradient(0deg, rgba(255, 255, 255, 1), rgba(255, 209, 145, 1) 10%, rgba(196, 140, 55, 1));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #shopify-section-{{ section.id }} .section-content .yg-gmv-title {
    color: #212121;
    font-size: 18px;
    font-weight: 600;
    line-height: 120%; /* 21.6px */
    letter-spacing: -0.36px;
  }

  #shopify-section-{{ section.id }} .section-content .yg-gmv-subtitle {
    margin-top: 8px;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .yg-content-image-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-around;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .yg-content-image-item {
    max-width: 120px;
  }

  #shopify-section-{{ section.id }} .yg-content-video-list {
    display: block;
    width: 100%;
    overflow: visible;
  }

  /* #shopify-section-{{ section.id }} .swiper-slide:not(.swiper-slide-prev, .swiper-slide-active, .swiper-slide-next, .swiper-slide-visible) {
    transform-origin: right top !important;
  }

  #shopify-section-{{ section.id }} .swiper-slide-active ~ .swiper-slide:not(.swiper-slide-prev, .swiper-slide-active, .swiper-slide-next, .swiper-slide-visible) {
    transform-origin: left top !important;
  }

  #shopify-section-{{ section.id }} .swiper-slide.swiper-slide-visible:not(.swiper-slide-prev, .swiper-slide-active, .swiper-slide-next) {
      transform-origin: center center !important;
  } */

  #shopify-section-{{ section.id }} .swiper-slide {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .swiper-slide .yg-content-video-container {
    position: relative;
    z-index: 1;
      pointer-events: none;
      border-radius: 16px;
      overflow: hidden;
      width: 100%;
      height: 80%;
  }

  #shopify-section-{{ section.id }} .swiper-slide:not(.swiper-slide-prev, .swiper-slide-active, .swiper-slide-next)  .yg-content-video-container {
    height: 100%;
  }

  #shopify-section-{{ section.id }} .swiper-slide .yg-content-video-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    display: none;
  }

  #shopify-section-{{ section.id }} .swiper-slide.swiper-slide-active .yg-content-video {
    mask-image: url({{ 'iphone-mask.png' | asset_url }});
    -webkit-mask-image: url({{ 'iphone-mask.png' | asset_url }});
    height: 100%;
    width: 100%;
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
  }

  #shopify-section-{{ section.id }} .swiper-slide.swiper-slide-active .yg-content-video-mask {
    display: block;
  }

  #shopify-section-{{ section.id }} video-media::part(play-button) {
    display: none;
  }

  #shopify-section-{{ section.id }} .yg-content-video-logo-container {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: start;
    top: 6%;
    right: 10%;
  }

  #shopify-section-{{ section.id }} .swiper-slide-active .yg-content-video-logo-container {
    top: 4%;
    right: 16%;
  }

  #shopify-section-{{ section.id }} .yg-content-video-logo-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    backdrop-filter: blur(10px);
    z-index: -1;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), rgba(0,0,0,0.5));
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), rgba(0,0,0,0.5));
    height: 100%;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .yg-content-video-logo {
    width: 64px;
    height: 64px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .section-content {
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .section-content .yg-content-data-list {
      grid-template-columns: repeat(1, 1fr);
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .section-content .yg-content-data {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .section-content .yg-gmv-header {
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .section-content .yg-gmv-amount {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .section-content .yg-gmv-title {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .yg-content-image-list {
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .yg-content-image-item {
      max-width: 90px;
    }

    #shopify-section-{{ section.id }} .yg-content-video-logo-container {
      position: absolute;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: start;
    }

    #shopify-section-{{ section.id }} .swiper-slide-active .yg-content-video-logo-container {

    }

    #shopify-section-{{ section.id }} .yg-content-video-logo {
      width: 48px;
      height: 48px;
    }
  }
</style>
{% if section.settings.background_image != blank %}
  {% render 'yg-image', img: section.settings.background_image, img_class: "yg-background-image" %}
{% endif %}
<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
