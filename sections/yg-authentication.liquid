<script>
  class YGContentVideoList extends HTMLElement {
    constructor() {
      super();
    }
    connectedCallback() {
      this.contentVideoList = this.querySelectorAll('.yg-content-video');
      this.initSwiper();
    }

    playVideo(activeVideoEl) {
      this.contentVideoList.forEach(function (videoEl) {
        videoEl.removeAttribute('playing');
        videoEl.removeAttribute('loaded');
        const video = videoEl.querySelector('video');
        if (video) video.pause();
      });

      if (activeVideoEl) {
        if (activeVideoEl) {
          activeVideoEl.setAttribute('playing', ' ');
          activeVideoEl.setAttribute('loaded', ' ');
          const video = activeVideoEl.querySelector('video');
          if (video) video.play();
        }
      }
    }

    initSwiper() {
      const swiper = new Swiper(this, {
        loop: true,
        // effect: 'creative',
        effect: 'coverflow',
        loopedSlides: 9,
        loopAdditionalSlides: 1,
        centeredSlides: true,
        slidesPerView: 'auto',
        slideToClickedSlide: true,
        coverflowEffect: {
         rotate: 0,
         scale: 0.85,
         stretch: '-10%',
         depth: 200,
         modifier: 1,
         slideShadows: false,
        },
        // creativeEffect: {
        //   limitProgress: 4,
        //   progressMultiplier: 1.1,
        //   prev: {
        //     origin: 'left center',
        //     scale: 0.8,
        //     translate: ['-90%', '2%', 0],
        //   },
        //   next: {
        //     origin: 'right center',
        //     scale: 0.8,
        //     translate: ['90%', '2%', 0],
        //   },
        // },
        breakpoints: {
          320: {
            slidesPerView: 1.2,
            spaceBetween: 0,
          },
          700: {
            slidesPerView: 2.4,
            spaceBetween: 0,
          },
          1024: {
            slidesPerView: 4,
            spaceBetween: 0,
          },
          1440: {
            slidesPerView: 5,
            spaceBetween: 0,
          },
        },
        on: {
          // slideChangeTransitionEnd有时监控不到
          slideChangeTransitionEnd: (e) => {
            const activeVideoEl = e.slides[e.activeIndex].querySelector('.yg-content-video');
            this.playVideo(activeVideoEl);
          },
          observerUpdate: (e) => {
            const activeVideoEl = e.slides[e.activeIndex].querySelector('.yg-content-video');
            this.playVideo(activeVideoEl);
          },
          transitionEnd: (e) => {
            const activeVideoEl = e.slides[e.activeIndex].querySelector('.yg-content-video');
            this.playVideo(activeVideoEl);
          },
        },
      });
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (!customElements.get('yg-content-video-list')) {
      customElements.define('yg-content-video-list', YGContentVideoList);
    }
  });
</script>

