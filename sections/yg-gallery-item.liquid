<style>
  {% if section.settings.remove_padding_top %}
   #shopify-section-{{ section.id }} .section-spacing {
     padding-block-start: 0;
   }

  {% endif %}

  @media(min-width: 700px) {

    {% if section.settings.remove_padding_bottom %}
     #shopify-section-{{ section.id }} .section-spacing {
       padding-block-end: 0;
     }

    {% endif %}
  }

   #shopify-section-{{ section.id }} .section-header {
    color: {{ section.settings.title_color }};
   }
   #shopify-section-{{ section.id }} .yg-gallery-item-wrapper {
     width: 100%;
     padding: 2.5rem;
     display: flex;
     flex-direction: column;
     justify-content: space-between;
     transform: none;
     transition-property: padding;
     transition-delay: .5s;
     transition-duration: 1s;
     transition-timing-function: ease;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-image {
     width: 100%;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-icon {
     height: 1.5rem;
     width: auto;
     transform: none;
     transition-property: height;
     transition-delay: .3s;
     transition-duration: 0.4s;
     transition-timing-function: ease-in-out;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-icon .yg-image-box {
     height: 100%;
     width: auto;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-content {
     position: static;
     display: flex;
     align-items: center;
     justify-content: space-between;
     width: 100%;
     opacity: 1;
     transform: none;
     transition-property: opacity, transform;
     transition-delay: .5s;
     transition-duration: 1s;
     transition-timing-function: ease;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-list {
     display: grid;
     grid-template-columns: repeat(3, 1fr);
     gap: 0.625rem;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-link *:where(a, button) {
     --size: 3rem;
     display: flex;
     aspect-ratio: 1 / 1;
     width: var(--size);
     height: var(--size);
     border: 1px solid;
     align-items: center;
     justify-content: center;
     border-radius: 50%;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-box {
     display: grid;
     gap: 0.5rem;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-box:not(:first-child) {
     padding-left: 0.625rem;
     border-left: 1px solid rgba(255, 255, 255, 0.20);
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-title {
     font-size: 1.5rem;
     font-weight: 500;
   }

   #shopify-section-{{ section.id }} .yg-gallery-item-label {
     font-size: 0.875rem;
     font-weight: 500;
     opacity: 0.6;
   }

   @media (min-width: 700px) {
     #shopify-section-{{ section.id }} .yg-gallery-item-inner {
       display: flex;
       flex-wrap: nowrap;
       overflow: hidden;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item {
       display: flex;
       position: relative;
       transition: flex .8s cubic-bezier(.29, 0, .2, 1);
       will-change: flex;
       overflow: hidden;
       height: auto;
       flex: 1.5;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-image .yg-image-box {
       height: 88vh;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item.active {
       flex: {{ section.blocks.size }};
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-wrapper {
       position: absolute;
       top: 0;
       left: 0;
       width: 100%;
       height: 100%;
       background: linear-gradient(0deg, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0.20) 100%), linear-gradient(0deg, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0.20) 100%);
     }

     #shopify-section-{{ section.id }} .yg-gallery-item:not(.active) .yg-gallery-item-wrapper {
       padding-inline-start: 1.875rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item:not(.active) .yg-gallery-item-icon {
       height: 1.5rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item:not(.active) .yg-gallery-item-content {
       opacity: 0;
       transform: translateY(5%);
       transition: none;
     }
   }

   @media (max-width: 699px) {
     #shopify-section-{{ section.id }} .yg-gallery-item-wrapper {
       color: var(--color);
       padding: 2.5rem 1.25rem 0;
       gap: 1.5rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-list {
       width: 100%;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-icon {
       display: flex;
       align-items: center;
       justify-content: space-between;
       height: auto;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-icon .yg-image-box {
       height: 1.5rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-box:not(:first-child) {
       border-left: 1px solid rgba(26, 26, 26, 0.20);
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-box {
       gap: 0.25rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-title {
       color: var(--color);
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-label {
       font-size: 0.75rem;
       color: var(--color);
       opacity: 0.6;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-link *:where(a, button) {
       --size: 1.875rem;
       border-width: 1.5px;
     }

     #shopify-section-{{ section.id }} .yg-gallery-item-link *:where(a, button) svg {
       width: 0.875rem;
     }

     #shopify-section-{{ section.id }} .yg-gallery-pagination {
       position: absolute;
       bottom: 22px;
       left: 50%;
       transform: translateX(-50%);
       z-index: 1;
       display: flex;
       align-items: center;
       justify-content: center;
     }

     #shopify-section-{{ section.id }} .yg-gallery-pagination .swiper-pagination-bullet {
       --swiper-pagination-bullet-inactive-color: #fff;
       --swiper-pagination-color: #fff;
       border-radius: 0.5rem;
       transition: width ease-in-out 0.3s;
     }

     #shopify-section-{{ section.id }} .yg-gallery-pagination .swiper-pagination-bullet.swiper-pagination-bullet-active {
       width: 2.5rem;
     }
   }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}
  <div class="section-spacing">
    <div class="section-stack">
      {%- if section.settings.title != blank
        or section.settings.heading != blank
        or section.settings.content != blank
      -%}
        <yg-animation-item class="section-header">
          <div class="prose prose-justify-{{ alignment }}">
            <div class="max-w-lg">
              {%- render 'subheading', content: section.settings.subheading -%}
              {%- render 'heading',
                content: section.settings.title,
                balance_text: true,
                style: section.settings.heading_tag,
                html_tag: 'h2'
              -%}
            </div>

            {%- if section.settings.content != blank -%}
              <div class="max-w-sm">
                {{- section.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </yg-animation-item>
      {%- endif -%}
      <yg-gallery-slide>
        <div class="yg-gallery-item-container swiper">
          <div class="swiper-wrapper yg-gallery-item-inner">
            {% for block in section.blocks %}
              <div class="swiper-slide yg-gallery-item{% if forloop.first %} active{% endif %}">
                <div class="yg-gallery-item-image">
                  {% render 'yg-image',
                    img: block.settings.image,
                    img_mobile: block.settings.image_mobile,
                    img_class: 'yg-featured-image',
                    show_placeholder: true,
                    is_lazy: false
                  %}
                </div>
                <div class="yg-gallery-item-wrapper hide-mobile" style="--color: {{ section.settings.color }};">
                  {% if block.settings.icon != blank %}
                    <div class="yg-gallery-item-icon">
                      {% render 'yg-image',
                        img: block.settings.icon,
                        img_mobile: block.settings.icon_mobile,
                        img_class: 'yg-featured-image',
                        show_placeholder: true,
                        is_lazy: false
                      %}

                      {% if block.settings.link != blank %}
                        <div class="yg-gallery-item-link hide-pc">
                          <a href="{{ block.settings.link }}" title="{{ shop.name }}">
                            <svg
                              width="24"
                              height="24"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd"
                              			d="M17.6584 5.59375C18.0727 5.59375 18.4084 5.92955 18.4084 6.34375V14.8291C18.4084 15.2432 18.0727 15.5791 17.6584 15.5791C17.2442 15.5791 16.9084 15.2432 16.9084 14.8291V8.15442L6.87505 18.1878C6.58217 18.4807 6.10729 18.4807 5.8144 18.1878C5.5215 17.8949 5.5215 17.42 5.8144 17.1272L15.8477 7.09375H9.17315C8.75895 7.09375 8.42315 6.75797 8.42315 6.34375C8.42315 5.92955 8.75895 5.59375 9.17315 5.59375H17.6584Z"
                              			fill="currentColor"/>
                            </svg>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="yg-gallery-item-content">
                    <div class="yg-gallery-item-list">
                      {% for i in (1..3) %}
                        {% liquid
                          assign titlei = 'title' | append: i
                          assign labeli = 'label' | append: i
                          assign title = block.settings[titlei]
                          assign label = block.settings[labeli]
                        %}
                        {% if title != blank or label != blank %}
                          <div class="yg-gallery-item-box">
                            <span class="yg-gallery-item-title">{{ title }}</span>
                            <span class="yg-gallery-item-label">{{ label }}</span>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% if block.settings.link != blank %}
                      <div class="yg-gallery-item-link hide-mobile">
                        <a href="{{ block.settings.link }}" title="{{ shop.name }}">
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path fill-rule="evenodd" clip-rule="evenodd"
                            			d="M17.6584 5.59375C18.0727 5.59375 18.4084 5.92955 18.4084 6.34375V14.8291C18.4084 15.2432 18.0727 15.5791 17.6584 15.5791C17.2442 15.5791 16.9084 15.2432 16.9084 14.8291V8.15442L6.87505 18.1878C6.58217 18.4807 6.10729 18.4807 5.8144 18.1878C5.5215 17.8949 5.5215 17.42 5.8144 17.1272L15.8477 7.09375H9.17315C8.75895 7.09375 8.42315 6.75797 8.42315 6.34375C8.42315 5.92955 8.75895 5.59375 9.17315 5.59375H17.6584Z"
                            			fill="currentColor"/>
                          </svg>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="yg-gallery-pagination hide-pc"></div>
        </div>
        <div class="yg-gallery-thumb-container hide-pc swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide yg-gallery-item-thumb">
                <div class="yg-gallery-item-wrapper" style="--color: {{ section.settings.color }};">
                  {% if block.settings.icon != blank %}
                    <div class="yg-gallery-item-icon">
                      {% render 'yg-image',
                        img: block.settings.icon,
                        img_mobile: block.settings.icon_mobile,
                        img_class: 'yg-featured-image',
                        show_placeholder: true,
                        is_lazy: false
                      %}

                      {% if block.settings.link != blank %}
                        <div class="yg-gallery-item-link hide-pc">
                          <a href="{{ block.settings.link }}" title="{{ shop.name }}">
                            <svg
                              width="24"
                              height="24"
                              viewBox="0 0 24 24"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path fill-rule="evenodd" clip-rule="evenodd"
                              			d="M17.6584 5.59375C18.0727 5.59375 18.4084 5.92955 18.4084 6.34375V14.8291C18.4084 15.2432 18.0727 15.5791 17.6584 15.5791C17.2442 15.5791 16.9084 15.2432 16.9084 14.8291V8.15442L6.87505 18.1878C6.58217 18.4807 6.10729 18.4807 5.8144 18.1878C5.5215 17.8949 5.5215 17.42 5.8144 17.1272L15.8477 7.09375H9.17315C8.75895 7.09375 8.42315 6.75797 8.42315 6.34375C8.42315 5.92955 8.75895 5.59375 9.17315 5.59375H17.6584Z"
                              			fill="currentColor"/>
                            </svg>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="yg-gallery-item-content">
                    <div class="yg-gallery-item-list">
                      {% for i in (1..3) %}
                        {% liquid
                          assign titlei = 'title' | append: i
                          assign labeli = 'label' | append: i
                          assign title = block.settings[titlei]
                          assign label = block.settings[labeli]
                        %}
                        {% if title != blank or label != blank %}
                          <div class="yg-gallery-item-box">
                            <span class="yg-gallery-item-title">{{ title }}</span>
                            <span class="yg-gallery-item-label">{{ label }}</span>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% if block.settings.link != blank %}
                      <div class="yg-gallery-item-link hide-mobile">
                        <a href="{{ block.settings.link }}" title="{{ shop.name }}">
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path fill-rule="evenodd" clip-rule="evenodd"
                            			d="M17.6584 5.59375C18.0727 5.59375 18.4084 5.92955 18.4084 6.34375V14.8291C18.4084 15.2432 18.0727 15.5791 17.6584 15.5791C17.2442 15.5791 16.9084 15.2432 16.9084 14.8291V8.15442L6.87505 18.1878C6.58217 18.4807 6.10729 18.4807 5.8144 18.1878C5.5215 17.8949 5.5215 17.42 5.8144 17.1272L15.8477 7.09375H9.17315C8.75895 7.09375 8.42315 6.75797 8.42315 6.34375C8.42315 5.92955 8.75895 5.59375 9.17315 5.59375H17.6584Z"
                            			fill="currentColor"/>
                          </svg>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </yg-gallery-slide>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    class YGGallerySlide extends HTMLElement {
      constructor() {
        super();
        this.swiperInstance = null;
        this.handleResize = this.handleResize.bind(this);
        this.handleItemHover = this.handleItemHover.bind(this);
        this.currentActiveItem = null;
      }

      get items() {
        return this.querySelectorAll('.yg-gallery-item');
      }

      connectedCallback() {
        this.handleResize();
        window.addEventListener('resize', this.handleResize);
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize);
        this.destroySwiper();
        this.removeHoverListeners();
      }

      initSwiper() {
        if (this.swiperInstance) return;

        const galleryContainer = this.querySelector('.yg-gallery-item-container');
        const thumbContainer = this.querySelector('.yg-gallery-thumb-container');

        this.thumbSwiperInstance = new Swiper(thumbContainer, {
          slidesPerView: 1,
          spaceBetween: 16,
          watchSlidesProgress: true,
          slideToClickedSlide: true,
          effect: 'fade',
          on: {
            slideChange: () => {
              const activeIndex = this.thumbSwiperInstance.realIndex;
              this.swiperInstance.slideTo(activeIndex);
            },
          },
        });

        this.swiperInstance = new Swiper(galleryContainer, {
          spaceBetween: 16,
          slidesPerView: 1,
          effect: 'fade',
          thumbs: {
            swiper: this.thumbSwiperInstance,
          },
          pagination: {
            el: '.yg-gallery-pagination',
            clickable: true,
          },
          breakpoints: {
            220: {
              slidesPerView: 1,
              spaceBetween: 16,
            },
          },
        });
      }

      destroySwiper() {
        if (this.swiperInstance) {
          this.swiperInstance.destroy(true, true);
          this.swiperInstance = null;
        }
      }

      handleResize() {
        const width = window.innerWidth;
        if (width < 700) {
          this.initSwiper();
          this.removeHoverListeners();
          this.clearActiveItems();
        } else {
          this.destroySwiper();
          this.addHoverListeners();
        }
      }

      addHoverListeners() {
        this.items.forEach((item) => {
          item.removeEventListener('mouseenter', this.handleItemHover);
          item.addEventListener('mouseenter', this.handleItemHover);
          item.removeEventListener('mouseleave', this.handleItemHover);
          item.addEventListener('mouseleave', this.handleItemHover);
        });
      }

      removeHoverListeners() {
        this.items.forEach((item) => {
          item.removeEventListener('mouseenter', this.handleItemHover);
          item.removeEventListener('mouseleave', this.handleItemHover);
        });
      }

      clearActiveItems() {
        this.items.forEach((item) => item.classList.remove('active'));
        this.currentActiveItem = null;
      }

      handleItemHover(e) {
        const type = e.type;
        const target = e.currentTarget;

        if (type === 'mouseenter') {
          this.items.forEach((item) => item.classList.remove('active'));
          target.classList.add('active');
          this.currentActiveItem = target;
        } else if (type === 'mouseleave') {
          setTimeout(() => {
            const hoverItem = [...this.items].find((item) => item.matches(':hover'));
            if (!hoverItem && this.currentActiveItem) {
              this.currentActiveItem.classList.add('active');
            }
          }, 10);
        }
      }
    }

    if (!window.customElements.get('yg-gallery-slide')) {
      window.customElements.define('yg-gallery-slide', YGGallerySlide);
    }
  });
</script>
{% schema %}
{
  "name": "YG gallery tem",
  "settings": [
    {
