{%- if section.settings.secondary_media_shape contains 'blob' -%}
  {{- 'clip-blob.css' | asset_url | stylesheet_tag -}}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.content_position == 'start' -%}
      --section-split-grid-template-columns: minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- else -%}
      --section-split-grid-template-columns: minmax(0, {{ section.settings.content_percentage_width | divided_by: 100.0 }}fr) minmax(0, {{ 100 | minus: section.settings.content_percentage_width | divided_by: 100.0 }}fr);
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .container {
    {% if section.settings.enable_custom_padding %} 
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .max-w-sm-l {
    max-width: 620px;
  }
  #shopify-section-{{ section.id }} + .shopify-section {
    --section-enable-padding-collapsing: 0; /* We turn off the padding collapsing on next section */
  }

  #shopify-section-{{ section.id }} .text-with-media-heading {
    margin-block-start: 1rem;
  }
  
  #shopify-section-{{ section.id }} .text-with-richtext {
    font-size: var(--font-size);
    color: rgb(var(--text-color));
    line-height: 1.6;
  }

  .prose .text-with-richtext :where(p,ol,ul,form,hr,table,.accordion) {
    margin-block-start: 1.75rem;
  }
  
  #shopify-section-{{ section.id }} .text-with-double-button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 2.5rem;
  }
  
  #shopify-section-{{ section.id }} .text-with-double-button * {
    margin-block-start: 0;
  }
  
  #shopify-section-{{ section.id }} .text-with-double-button button {
    opacity: 0.6;
    cursor: default;
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 500;
  }
  
  #shopify-section-{{ section.id }} .text-with-double-button button .button__content {
    padding: 0.5rem 1.5rem;
  }
  
  #shopify-section-{{ section.id }} .section-split .section-split__column--image,
  #shopify-section-{{ section.id }} .section-split.section-split--reverse .section-split__column:not(.section-split__column--image) {
    order: 2;
  }
  
  #shopify-section-{{ section.id }} .section-split.section-split--reverse .section-split__column--image {
    order: 1;
  }

  #shopify-section-{{ section.id }} .text-with-richtext strong {
    font-size: 120%;
  }

  #shopify-section-{{ section.id }} .yg-block {
    margin-top: var(--margin-top);
  }

  #shopify-section-{{ section.id }} .yg-block p {
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .yg-growth-formula {
    display: grid;
    grid-template-columns: auto 1fr;
    width: fit-content;
    gap: 10px;
    padding: 4px;
    text-align: center;
    border-radius: 40px;
    border: 1px solid rgba(0, 0, 0, 0.10);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth-list {
    display: grid;
    grid-template-columns: 1fr 36px 1fr;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border-radius: 40px;
    font-weight: 600;
    padding-inline: 24px;
    background: #F8F7F7;
  }

  #shopify-section-{{ section.id }} .yg-growth-formula .yg-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    width: 36px;
    border: 1.5px dashed #212121;
    border-radius: 40px;
  }

  #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth-result {
    display: grid;
    grid-template-columns: 36px 1fr;
    align-items: center;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .yg-growth-formula .yg-result {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    border-radius: 40px;
    padding-inline: 24px;
    font-weight: 600;
    background: #FFC000;
  }

  #shopify-section-{{ section.id }} .yg-content-box {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .yg-content-box .yg-image-box {
    width: var(--image-width, 100%);
  }

  #shopify-section-{{ section.id }} .yg-content-box .constrained-image {
    border-radius: 8px;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .yg-content-box:not(.in-bottom, .in-top) .constrained-image {
    border-radius: 8px;
    width: 100%;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-bottom .yg-image-box-primary .constrained-image {
    margin-bottom: -40px;
    margin-left: auto;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-top {
    flex-direction: column-reverse;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-top .yg-image-box-primary .constrained-image {
    margin-top: -40px;
    margin-left: auto;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-right {
    flex-direction: row;
    align-items: end;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-left {
    flex-direction: row-reverse;
    align-items: end;
  }

  #shopify-section-{{ section.id }} .yg-content-box.in-right .yg-image-box-secondary {
    margin-left: -25px;
    margin-bottom: -45px;
  }
  #shopify-section-{{ section.id }} .yg-content-box.in-left .yg-image-box-secondary {
    margin-right: -25px;
    margin-bottom: -45px;
  }
  #shopify-section-{{ section.id }} .yg-content-box.yg-rotate {
    
  }
  #shopify-section-{{ section.id }} .yg-content-box.yg-rotate .yg-image-box {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .yg-content-box.yg-rotate .yg-image-box-primary {
    transform:  translate(30px, 0) rotate(-3deg);
  }
  #shopify-section-{{ section.id }} .yg-content-box.yg-rotate .yg-image-box-secondary {
    transform: translate(0, -15%);
  }
  #shopify-section-{{ section.id }} .yg-content-box.yg-rotate .yg-image-box-third {
    transform: translate(-30px, 40px) rotate(8deg)
  }

  @media (max-width: 1150px) and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .yg-growth-formula {
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth-list {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 4px;
    }
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-symbol {
      border: none;
      height: 16px;
      width: 16px;
    } 
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-result {
      border-radius: 12px;
      height: 100%;
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .yg-growth-formula {
      border-radius: 28px;
      border-style: dashed;
    }
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth-list {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 4px;
    }
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-symbol {
      border: none;
      height: 16px;
      width: 16px;
    } 
    #shopify-section-{{ section.id }} .yg-growth-formula .yg-result {
      border-radius: 28px;
      height: 100%;
    }
  }
  @media (max-width: 460px) {
    #shopify-section-{{ section.id }} .yg-growth-formula {
      width: 100%;
      grid-template-columns: calc(50% - 28px) calc(50% + 18px);
    }

    #shopify-section-{{ section.id }} .yg-growth-formula .yg-growth {
      width: 100%;
    }
  }
  #shopify-section-{{ section.id }} .yg-accordion-list {
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 40px;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list .yg-row {
    --content-height: auto;
    display: flex;
    flex-direction: column;
    align-items: start;
    opacity: 0.4;
    transition: opacity 0.3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list .yg-row .yg-col-first {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list .yg-row .yg-col-last {
    --active-padding-top: 12px;

    padding-top: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #5E6075;
    height: 0;
    overflow: hidden;
    transition: height 0.3s ease-in-out, padding-top 0.3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list .yg-row.active {
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .yg-accordion-list .yg-row.active .yg-col-last {
    padding-top: var(--active-padding-top);
    height: var(--content-height);
  }

  #shopify-section-{{ section.id }} .yg-accordion-list {
    position: relative;
    z-index: 1;
    padding-left: 24px;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list  .yg-accordion-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: #EDEDED;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .yg-accordion-list  .yg-accordion-bar .yg-current-bar {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0;
    background-color: #FFC000;
  }

  #shopify-section-{{ section.id }} .yg-content-box {
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .yg-content-box .yg-image-box-mask {
    position: absolute;
    z-index: -1;
    top: 0;
    right: var(--mask-video-inline, 0);
    height: 100%;
    width: auto !important;
  }

  #shopify-section-{{ section.id }} .yg-content-box .yg-image-box-mask.custom-mask {
    right: 5%;
    width: 70% !important;
  }

  #shopify-section-{{ section.id }} .yg-content-box .yg-image-box-mask .constrained-image {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    mask-image: var(--mask-image, url({{ 'iphone-mask.png' | asset_url }}));
    -webkit-mask-image: var(--mask-image, url({{ 'iphone-mask.png' | asset_url }}));
    height: 100%;
    width: 100%;
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
  }
  
  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .container {
      {% if section.settings.enable_custom_padding %} 
        padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .section-split {
      display: flex;
      flex-direction: column;
    }
    
    #shopify-section-{{ section.id }} .text-with-richtext {
      font-size: var(--font-size-mobile);
      line-height: 1.3;
    }
    
    #shopify-section-{{ section.id }} .text-with-double-button button {
      font-size: 0.9375rem;
    }
    
    #shopify-section-{{ section.id }} .text-with-media-heading {
      margin-block-start: 0.5rem;
      line-height: 1.2em;
    }
    
    #shopify-section-{{ section.id }} .yg-text-media-separator {
      display: block;
      width: 90%;
      height: 1px;
      background: rgba(0, 0, 0, 0.10);
      margin-inline: auto;
      margin-block-start: 3.125rem;
    }

    #shopify-section-{{ section.id }} .section-split__column:where(:last-child) {
      {% if section.settings.content_position_y == 'start' %}
        order: 0 !important;
      {% endif %}

      padding-block: var(--section-stack-row-gap);
      {% unless section.settings.full_width %}
        padding: 0;
      {% endunless %}
    }

    #shopify-section-{{ section.id }} .yg-block {
      margin-top: var(--margin-top-mobile);
    }

    #shopify-section-{{ section.id }} .yg-accordion-list {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .yg-accordion-list .yg-row .yg-col-first {
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .yg-accordion-list .yg-row .yg-col-last {
      --active-padding-top: 8px;
      font-size: 14px;
    }
    #shopify-section-{{ section.id }} .yg-content-box .yg-image-box {
      width: var(--image-mobile-width, 100%);
    }
    #shopify-section-{{ section.id }} .section-split__column--image {
      padding-inline: 0;
      padding-bottom: 60px;
    }

    #shopify-section-{{ section.id }} .yg-content-box .yg-image-box-mask.custom-mask {
      right: 5%;
      width: 90% !important;
    }

  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="section-split {% unless section.settings.full_width %} container {% endunless %} {% if section.settings.content_position == 'end' %}section-split--reverse{% endif %}">
    {%- comment -%}
    IMAGE PART
    {%- endcomment -%}

    <{% if section.settings.show_dynamic %}yg-animation-item{% else %}div{% endif %} class="section-split__column section-split__column--image {% unless section.settings.add_media_spacing %}section-split__column--flushed{% endunless %}">
      {% comment %} <div class="content-box h-full">
        <div class="content-box__background-media">
          {%- liquid
            if section.settings.primary_video != blank
              assign show_controls = true

              if section.settings.autoplay_video
                assign show_controls = false
              endif

              render 'media', media: section.settings.primary_video, autoplay: section.settings.autoplay_video, loop: section.settings.autoplay_video, controls: show_controls
            elsif section.settings.primary_image != blank
              echo section.settings.primary_image | image_url: width: section.settings.primary_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,500,600,800,1000,1200,1400,1600,1800,2000'
            elsif section.settings.secondary_image == blank and section.settings.secondary_video == blank
              echo 'blog-apparel-2' | placeholder_svg_tag: 'size-full'
            endif
          -%}
        </div>

        {%- if section.settings.secondary_image != blank or section.settings.secondary_video != blank -%}
          {%- capture media_style -%}--image-mobile-max-width: {{ section.settings.secondary_media_mobile_width }}%; --image-max-width: {{ section.settings.secondary_media_width }}%{%- endcapture -%}
          {%- capture media_class -%}{{ section.settings.secondary_media_alignment }} constrained-image clip-{{ section.settings.secondary_media_shape }} {% if section.settings.secondary_media_shape == 'circle' %}aspect-square{% endif %} {% unless section.settings.show_secondary_media_on_mobile %}sm-max:hidden{% endunless %}{%- endcapture -%}

          {%- if section.settings.secondary_video != blank -%}
            {%- render 'media', media: section.settings.secondary_video, autoplay: true, loop: true, class: media_class, style: media_style -%}
          {%- else -%}
            {{- section.settings.secondary_image | image_url: width: section.settings.secondary_image.width | image_tag: sizes: '(max-width: 699px) 275px, 400px', widths: '200,300,400,500,600,800,1000,1200', class: media_class, style: media_style -}}
          {%- endif -%}
        {%- endif -%}
      </div> {% endcomment %}
      <div class="yg-content-box {{ section.settings.secondary_media_alignment }} {% if section.settings.rotate %} yg-rotate {% endif %}">
        <div class="yg-image-box yg-image-box-primary" {% if section.settings.secondary_media_alignment == 'in-left' or section.settings.secondary_media_alignment == 'in-right' %} {% if section.settings.secondary_image != blank or section.settings.secondary_video != blank %} style="--image-width: {{ section.settings.primary_media_width }}%; --image-mobile-width: {{ section.settings.primary_media_mobile_width }}%;"  {% endif %}{% endif %}>
          {% if section.settings.secondary_media_alignment == 'in-top' or section.settings.secondary_media_alignment == 'in-bottom' %}
            {% if section.settings.secondary_image != blank or section.settings.secondary_video != blank %}
              {%- capture media_style -%}--image-mobile-max-width: {{ section.settings.primary_media_mobile_width }}%; --image-max-width: {{ section.settings.primary_media_width }}%{%- endcapture -%}
            {% endif -%}
          {% endif -%}
          {%- capture media_class -%}constrained-image{%- endcapture -%}

          {%- liquid
            if section.settings.primary_video != blank
              render 'media', media: section.settings.primary_video, autoplay: true, loop: true, class: media_class, style: media_style
            elsif section.settings.primary_image != blank
              echo section.settings.primary_image | image_url: width: section.settings.primary_image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,500,600,800,1000,1200,1400,1600,1800,2000', class: media_class, style: media_style
            elsif section.settings.secondary_image == blank and section.settings.secondary_video == blank
              echo 'blog-apparel-2' | placeholder_svg_tag: 'size-full'
            endif
          -%}
        </div>

        {%- if section.settings.secondary_image != blank or section.settings.secondary_video != blank -%}
          <div class="yg-image-box yg-image-box-secondary" {% if section.settings.secondary_media_alignment == 'in-left' or section.settings.secondary_media_alignment == 'in-right' %} {% if section.settings.secondary_image != blank or section.settings.secondary_video != blank %} style="--image-width: {{ section.settings.secondary_media_width }}%; --image-mobile-width: {{ section.settings.secondary_media_mobile_width }}%;"  {% endif %} {% endif %}>
            {% if section.settings.secondary_media_alignment == 'in-top' or section.settings.secondary_media_alignment == 'in-bottom' %}
              {%- capture media_style -%}--image-mobile-max-width: {{ section.settings.secondary_media_mobile_width }}%; --image-max-width: {{ section.settings.secondary_media_width }}%{%- endcapture -%}
            {% endif -%}
            {%- capture media_class -%}constrained-image{%- endcapture -%}
  
            {%- if section.settings.secondary_video != blank -%}
              {%- render 'media', media: section.settings.secondary_video, autoplay: true, loop: true, class: media_class, style: media_style -%}
            {%- else -%}
              {{- section.settings.secondary_image | image_url: width: section.settings.secondary_image.width | image_tag: sizes: '(max-width: 699px) 275px, 400px', widths: '200,300,400,500,600,800,1000,1200', class: media_class, style: media_style -}}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.third_image != blank or section.settings.third_video != blank -%}
          <div class="yg-image-box yg-image-box-third" {% if section.settings.secondary_media_alignment == 'in-left' or section.settings.secondary_media_alignment == 'in-right' %} {% if section.settings.secondary_image != blank or section.settings.secondary_video != blank %} style="--image-width: {{ section.settings.third_media_width }}%; --image-mobile-width: {{ section.settings.third_media_mobile_width }}%;"  {% endif %} {% endif %}>
            {% if section.settings.secondary_media_alignment == 'in-top' or section.settings.secondary_media_alignment == 'in-bottom' %}
              {%- capture media_style -%}--image-mobile-max-width: {{ section.settings.third_media_mobile_width }}%; --image-max-width: {{ section.settings.third_media_width }}%{%- endcapture -%}
            {% endif -%}
            {%- capture media_class -%}constrained-image{%- endcapture -%}

            {%- if section.settings.third_video != blank -%}
              {%- render 'media', media: section.settings.third_video, autoplay: true, loop: true, class: media_class, style: media_style -%}
            {%- else -%}
              {{- section.settings.third_image | image_url: width: section.settings.third_image.width | image_tag: sizes: '(max-width: 699px) 275px, 400px', widths: '200,300,400,500,600,800,1000,1200', class: media_class, style: media_style -}}
            {%- endif -%}
          </div>
        {%- endif -%}
        
        {%- if section.settings.mask_video != blank -%}
          <div class="yg-image-box yg-image-box-mask {% if section.settings.mask_image != blank %} custom-mask {% endif %}" style="{% if section.settings.mask_image != blank %}--mask-image: url({{ section.settings.mask_image | image_url: width: section.settings.mask_image.width }}); {% endif %} --mask-video-inline: {{ section.settings.mask_video_inline }}%;">
            {%- capture media_class -%}constrained-image{%- endcapture -%}
              {% if section.settings.mask_image == blank %}
                <img src="{{ 'iphone.png' | asset_url }}" alt="" class="yg-content-video-mask">
              {% endif %}
              {%- render 'media', media: section.settings.mask_video, autoplay: true, loop: true, class: media_class, style: media_style -%}
          </div>
        {%- endif -%}
      </div>
    </{% if section.settings.show_dynamic %}yg-animation-item{% else %}div{% endif %}>
    
    {%- comment -%}
    CONTENT PART
    {%- endcomment -%}

    {%- liquid
      assign top_left_content = ''
      assign top_center_content = ''
      assign top_right_content = ''
      assign middle_left_content = ''
      assign middle_center_content = ''
      assign middle_right_content = ''
      assign bottom_left_content = ''
      assign bottom_center_content = ''
      assign bottom_right_content = ''
      assign all_content = ''
    -%}

    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- capture block_content -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              {% assign hide_icon = block.settings.hide_icon %}
              {%- render 'subheading', content: block.settings.text, block: block, hide_icon: hide_icon -%}

            {%- when 'heading' -%}
              {%- render 'heading', 
                content: block.settings.text, 
                highlight_effect: block.settings.highlight_effect, 
                highlight_accent_color: block.settings.highlight_accent_color, 
                highlight_text_color: block.settings.highlight_text_color, 
                style: block.settings.heading_tag,
                html_tag: block.settings.html_tag,
                block: block,
                class: 'text-with-media-heading max-w-sm-l' 
              -%}

            {%- when 'button' -%}
              {%- render 'button', 
                content: block.settings.text,
                href: block.settings.url,
                style: block.settings.style,
                background: block.settings.background,
                text_color: block.settings.text_color,
                block: block
              -%}
            
            {%- when 'double_button' -%}
            <div class="text-with-double-button">
              {%- render 'button',
                content: block.settings.text,
                href: block.settings.url,
                style: block.settings.style,
                background: block.settings.background,
                text_color: block.settings.text_color,
                block: block
              -%}
              
              {% if block.settings.text2 != blank %}
                 {%- render 'button',
                   content: block.settings.text2,
                   href: block.settings.url2,
                   style: block.settings.style,
                   background: block.settings.background,
                   text_color: block.settings.text_color,
                   block: block
                 -%}
              {% endif %}
            </div>

            {%- when 'icon' -%}
              {%- if block.settings.image != blank -%}
                {%- render 'icon', image: block.settings.image, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, block: block -%}
              {%- else -%}
                {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, mobile_width: block.settings.mobile_icon_width, stroke_width: block.settings.icon_stroke_width, block: block -%}
              {%- endif -%}

            {%- when 'richtext' -%}
              {%- if block.settings.text != blank -%}
                {% if block.settings.enable_custom_margin %} 
                  {% capture block_style %}
                    --margin-top: {{ block.settings.margin_top | append: 'px' }};
                    --margin-top-mobile: {{ block.settings.margin_top_mobile | append: 'px' }};
                  {% endcapture %}
                {% endif %}
                <div class="max-w-sm text-with-richtext  {% if block.settings.enable_custom_margin %} yg-block {% endif %}" style="{{ block_style }} --font-size: {{ block.settings.font_size | divided_by: 16.0 | append: 'rem' }}; --font-size-mobile: {{ block.settings.font_size_mobile | divided_by: 16.0 | append: 'rem' }};{% if block.settings.color != blank %}--text-color: {{ block.settings.color.rgb }}{% endif %}" {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </div>
              {%- endif -%}
            {%- when 'yg_growth_formula' -%}
                {% capture block_style %}
                  --margin-top: {{ block.settings.margin_top | append: 'px' }};
                  --margin-top-mobile: {{ block.settings.margin_top_mobile | append: 'px' }};
                {% endcapture %}
                <div class="yg-growth-formula yg-block" style="{{ block_style }}">
                  <div class="yg-growth-list">
                    <div class="yg-growth">
                      {{ block.settings.text1 }}
                    </div>
                    <div class="yg-symbol">
                      +
                    </div>
                    <div class="yg-growth">
                      {{ block.settings.text2 }}
                    </div>
                  </div>
                  <div class="yg-growth-result">
                    <div class="yg-symbol result">=</div>
                    <div class="yg-result">{{ block.settings.text3 }}</div>
                  </div>
                </div>
              {%- when 'yg_accordion' -%}
                {% capture block_style %}
                  --margin-top: {{ block.settings.margin_top | append: 'px' }};
                  --margin-top-mobile: {{ block.settings.margin_top_mobile | append: 'px' }};
                {% endcapture %}
                <div class=" yg-block max-w-sm"  style="{{ block_style }}">
                  <yg-accordion class="yg-accordion-list">
                    <div class="yg-accordion-bar"><div class="yg-current-bar"></div></div>
                    {%- render 'yg-data-split' data: block.settings.content, col: 2 %}
                  </yg-accordion>
                </div>
          {%- endcase -%}
        {%- endcapture -%}

        {%- case block.settings.position -%}
          {%- when 'top_left' -%}
            {% assign top_left_content = top_left_content | append: block_content %}
          {%- when 'top_center' -%}
            {% assign top_center_content = top_center_content | append: block_content %}
          {%- when 'top_right' -%}
            {% assign top_right_content = top_right_content | append: block_content %}
          {%- when 'middle_left' -%}
            {% assign middle_left_content = middle_left_content | append: block_content %}
          {%- when 'middle_center' -%}
            {% assign middle_center_content = middle_center_content | append: block_content %}
          {%- when 'middle_right' -%}
            {% assign middle_right_content = middle_right_content | append: block_content %}
          {%- when 'bottom_left' -%}
            {% assign bottom_left_content = bottom_left_content | append: block_content %}
          {%- when 'bottom_center' -%}
            {% assign bottom_center_content = bottom_center_content | append: block_content %}
          {%- when 'bottom_right' -%}
            {% assign bottom_right_content = bottom_right_content | append: block_content %}
        {%- endcase -%}

        {%- assign all_content = all_content | append: block_content -%}
      {%- endfor -%}

      <{% if section.settings.show_dynamic %}yg-animation-item{% else %}div{% endif %} class="section-split__column {%- if section.settings.content_image_background != blank -%}section-split__column--flushed{% endif %} align-self-stretch">
        <div class="content-box min-h-full">
          {%- if section.settings.content_image_background != blank -%}
            <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
              {{- section.settings.content_image_background | image_url: width: section.settings.content_image_background.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '200,300,400,500,600,800,1000,1200,1400,1600,1800,2000' -}}
            </div>
          {%- endif -%}

          <div class="placement-grid {% unless section.settings.content_image_background %}span-full{% endunless %}">
            {% if top_left_content != blank %}
              <div class="place-self-start prose prose-justify-start">
                {{- top_left_content -}}
              </div>
            {%- endif -%}
      
            {% if top_center_content != blank %}
              <div class="place-self-start-center prose prose-justify-center">
                {{- top_center_content -}}
              </div>
            {%- endif -%}
      
            {% if top_right_content != blank %}
              <div class="place-self-start-end prose prose-justify-end">
                {{- top_right_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_left_content != blank %}
              <div class="place-self-center-start prose prose-justify-start">
                {{- middle_left_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_center_content != blank %}
              <div class="place-self-center prose prose-justify-center">
                {{- middle_center_content -}}
              </div>
            {%- endif -%}
      
            {% if middle_right_content != blank %}
              <div class="place-self-center-end prose prose-justify-end">
                {{- middle_right_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_left_content != blank %}
              <div class="place-self-end-start prose prose-justify-start">
                {{- bottom_left_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_center_content != blank %}
              <div class="place-self-end-center prose prose-justify-center">
                {{- bottom_center_content -}}
              </div>
            {%- endif -%}
      
            {% if bottom_right_content != blank %}
              <div class="place-self-end prose prose-justify-end">
                {{- bottom_right_content -}}
              </div>
            {%- endif -%}
          </div>
        </div>
      </{% if section.settings.show_dynamic %}yg-animation-item{% else %}div{% endif %}>
    {%- endif -%}
  </div>
  {% if section.settings.show_separator %}
    <div class="yg-text-media-separator hide-pc"></div>
  {% endif %}
</div>

