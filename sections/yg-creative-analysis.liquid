<style>
  #shopify-section-{{ section.id }} {
    background: #FCFCFC;
  }

  #shopify-section-{{ section.id }}:has(.yg-content-videos) {
    padding-bottom: 10%
  }

  #shopify-section-{{ section.id }} .color-scheme  {
    background-color: #222222;
  }
  #shopify-section-{{ section.id }} .section-spacing {
    {% if section.settings.enable_custom_padding %}
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} h2 {
    color: #EDEDED;
    font-size: 56px;
    font-weight: 600;
    line-height: 110%; /* 61.6px */
    letter-spacing: -0.56px;
    text-wrap: auto;
  }

  #shopify-section-{{ section.id }} .max-w-sm p {
    margin-top: 20px;
    color: rgba(237, 237, 237, 0.80);
    font-size: 18px;
    line-height: 140%;
    letter-spacing: -0.18px;
  }

  #shopify-section-{{ section.id }} .max-w-sm strong {
    color: rgba(237, 237, 237, 1);
  }

  #shopify-section-{{ section.id }} .yg-creative-analysis {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: calc(45% - 16px) calc(55% - 16px);
    gap: 24px 32px;
  }

  #shopify-section-{{ section.id }} .yg-content-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding-block-start: 96px;
  }

  #shopify-section-{{ section.id }} .yg-content-main .yg-image-box {
    border-radius: 12px;
    overflow: hidden;
    width: calc(100% - 64px);
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .yg-des {
    padding: 30px;
    border-radius: 12px;
    background-color: #FFC000;
    width: max(300px, 60%);
    margin-block-start: -64px;
    font-weight: 500;
    font-size: 15px;
    line-height: 1.4em;
    color: #212121;
    letter-spacing: -0.24px;
  }

  #shopify-section-{{ section.id }} .yg-des .yg-content-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4em;
    margin-block-end: 12px;
  }

  #shopify-section-{{ section.id }} .yg-des p {
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .yg-content-videos {
    height: 0;
    margin-top: -35%;
    width: 120%;
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(3, 1fr);
  }

  #shopify-section-{{ section.id }} .yg-content-video {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 9 / 18;
    border-radius: 23px;
    overflow: hidden;
    padding: 9.5px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .2) 0%, rgba(153, 153, 153, .2) 100%);
  }

  #shopify-section-{{ section.id }} .yg-content-video:nth-of-type(2) {
    transform: translateY(-64px);
  }

  #shopify-section-{{ section.id }} .yg-content-video .yg-icon-top {
    position: absolute;
    top: 17.5px;
    left: 50%;
    transform: translateX(-50%);
    width: 33%;
  }

  #shopify-section-{{ section.id }} .yg-content-video .yg-icon-top svg {
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .yg-content-video .yg-video {
    width: 100%;
    height: 100%;
    border-radius: 23px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .yg-content-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper {
    display: none;
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .section-spacing {
      {% if section.settings.enable_custom_padding %}
        padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .yg-creative-analysis {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .yg-content-main {
      padding-block-start: 0;
    }

    #shopify-section-{{ section.id }} .section-spacing:has(.yg-content-videos) {
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .yg-content-videos {
      position: static;
      transform: none;
      width: fit-content;
      height: auto;
      margin-top: 0;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-inline: -32px;
      padding-inline: 32px;
      background: linear-gradient(180deg, #222222 0%, #222222 70%, #FCFCFC 70%, #FCFCFC 100%);
    }

    #shopify-section-{{ section.id }} .yg-content-video:nth-of-type(2) {
      transform: none;
    }

  }

  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} {
      overflow: hidden
    }

    #shopify-section-{{ section.id }} h2 {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .max-w-sm p {
      margin-top: 16px;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .yg-content-main .yg-image-box {
      width: max(240px, 60%);
    }

    #shopify-section-{{ section.id }} .yg-des {
      padding: 20px 16px;
      font-size: 12px;
      width: max(280px, 70%);
    }

    #shopify-section-{{ section.id }} .yg-des .yg-content-title {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .yg-content-videos {
      display: none;
    }

    #shopify-section-{{ section.id }} .yg-blocks-swiper {
      display: block;
      overflow: visible;
      width: 100vw;
      margin-inline: -20px;
      padding-inline: 20px;
      padding-bottom: 30px;
      background: linear-gradient(180deg, #222222 0%, #222222 65%, #FCFCFC 65%, #FCFCFC 100%)
    }

    #shopify-section-{{ section.id }} .yg-blocks-swiper .swiper-slide {
      transform: translateY(55px) scale(0.9);
      transition: transform 0.3s ease;
    }

    #shopify-section-{{ section.id }} .yg-blocks-swiper .swiper-slide.swiper-slide-active {
      transform: none;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}

  <div class="container section-spacing">
    <div class="section-stack yg-creative-analysis">
      {%- if section.settings.title != blank
        or section.settings.heading != blank
        or section.settings.content != blank
      -%}
        <yg-animation-item class="section-header">
          <div class="prose prose-justify-{{ alignment }}">
            <div class="max-w-lg">
              {%- render 'subheading', content: section.settings.subheading -%}
              {%- render 'heading',
                content: section.settings.title,
                balance_text: true,
                style: section.settings.heading_tag,
                html_tag: 'h2'
              -%}
            </div>

            {%- if section.settings.content != blank -%}
              <div class="max-w-sm">
                {{- section.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </yg-animation-item>
      {%- endif -%}
      <div class="yg-content-main">
        {% render 'yg-image', img: section.settings.img, show_placeholder: true %}
        <yg-animation-item class="yg-des">
          {% if section.settings.content_title != blank %}
            <div class="yg-content-title">{{ section.settings.content_title }}</div>
          {% endif %}
          {{ section.settings.des }}
        </yg-animation-item>
      </div>

      {% if section.blocks.size > 0 %}
        <div class="yg-content-videos">
          {% for block in section.blocks %}
            <div class="yg-content-video">
              <div class="yg-icon-top">
                <svg width="72" height="16" viewBox="0 0 72 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="0.5" y="0.390137" width="70.7544" height="15.2982" rx="7.64912" fill="black"/>
                  <rect x="5.28027" y="5.64893" width="4.7807" height="4.7807" rx="2.39035" fill="#FD2B56"/>
                </svg>
              </div>
              <div class="yg-video">
                {{
                  block.settings.video
                  | video_tag: image_size: '1920x', loop: true, controls: false, autoplay: true, muted: true
                }}
              </div>
            </div>
          {% endfor %}
        </div>
        <yg-swiper
          class="swiper yg-blocks-swiper"
          data-breakpoints="260:1.8-12"
          data-centered-slides="true"
          data-loop="true"
          data-initial-slide="1"
        >
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="yg-content-video swiper-slide">
                <div class="yg-icon-top">
                  <svg width="72" height="16" viewBox="0 0 72 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="0.5" y="0.390137" width="70.7544" height="15.2982" rx="7.64912" fill="black"/>
                    <rect x="5.28027" y="5.64893" width="4.7807" height="4.7807" rx="2.39035" fill="#FD2B56"/>
                  </svg>
                </div>
                <div class="yg-video">
                  {{
                    block.settings.video
                    | video_tag: image_size: '1920x', loop: true, controls: false, autoplay: true, muted: true
                  }}
                </div>
              </div>
            {% endfor %}
          </div>
        </yg-swiper>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YG Creative Analysis",
  "class": "shopify-section--yg-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "content_title",
      "label": "Content Title"
    },
    {
      "type": "richtext",
      "id": "des",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": false
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "limit": 3,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG Creative Analysis"
    }
  ]
}
{% endschema %}
