<style>
  #shopify-section-{{ section.id }} .yg-hover-icons-items {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 0 3.75rem;
  }

  #shopify-section-{{ section.id }} .section-header {
    margin-block-end: 2.5rem;
  }

  #shopify-section-{{ section.id }} .yg-hover-icons-item .yg-image-box {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .yg-hover-icons-item .yg-image-box img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.8s cubic-bezier(0.4, 0, 0.2, 1),
    filter 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(1);
  }

  #shopify-section-{{ section.id }} .yg-hover-secondary-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .yg-hover-secondary-image img {
    opacity: 0.15;
    transform: scale(1.03);
    filter: blur(2px);
  }

  #shopify-section-{{ section.id }} .yg-hover-icons-item:hover .yg-hover-secondary-image img {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  #shopify-section-{{ section.id }} .yg-hover-icons-item:hover .yg-hover-icons-image img {
    opacity: 0;
    transform: scale(0.98);
    filter: blur(1.5px);
  }

  @media (max-width: 1200px) {
    #shopify-section-{{ section.id }} .yg-hover-icons-items {
      grid-template-columns: repeat({{ section.settings.columns | minus: 1 }}, 1fr);
    }
  }

  @media (max-width: 699px) {

    #shopify-section-{{ section.id }} .section-header {
      margin-block-end: 1.875rem;
    }

    #shopify-section-{{ section.id }} .yg-hover-icons-items {
      grid-template-columns: repeat({{ section.settings.columns_mobile}}, 1fr);
      gap: 0 0.75rem;
    }
  }
</style>

<div class="color-scheme relative color-scheme--{{ section.settings.color_scheme.id }}">
	{%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}
	<div class="container section-spacing">
		{%- if section.settings.title != blank or section.settings.heading != blank or section.settings.content != blank -%}
			<yg-animation-item class="section-header">
				<div class="prose prose-justify-{{ alignment }}">
					<div class="max-w-lg">
						{%- render 'subheading', content: section.settings.subheading -%}
						{%- render 'heading', content: section.settings.title, balance_text: true, class: 'yg-hover-icons-heading', style: section.settings.heading_tag, html_tag: 'h2' -%}
					</div>
					
					{%- if section.settings.content != blank -%}
						<div class="max-w-sm">
							{{- section.settings.content -}}
						</div>
					{%- endif -%}
					
					{%- render 'button',
						content: section.settings.text,
						href: section.settings.url,
						button_icon: section.settings.button_icon,
						style: section.settings.style,
						background: section.settings.background,
						text_color: section.settings.text_color,
						external: section.settings.open_in_new_tab,
						block: section
					-%}
				</div>
			</yg-animation-item>
		{%- endif -%}
		<div class="yg-hover-icons-items w-full max-w-2xl mx-auto">
			{% for block in section.blocks %}
				<yg-animation-item class="yg-hover-icons-item relative">
					{% render 'yg-image',
						img: block.settings.image,
						img_class: "yg-hover-icons-image",
						show_placeholder: false,
						is_no_lazy: true,
						is_lazy: false
					%}
					{% render 'yg-image',
						img: block.settings.hover_image,
						img_class: "yg-hover-secondary-image",
						show_placeholder: false,
						is_no_lazy: true,
						is_lazy: false
					%}
				</yg-animation-item>
			{% endfor %}
		</div>
	</div>
</div>

{% schema %}
{
  "name": "YG hover icons",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Text with icons"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:global.text.text",
      "default": "Button text"
    },
    {
      "type": "textarea",
      "id": "button_icon",
      "label": "Button icon"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:global.text.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:global.text.open_in_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:global.text.style",
      "options": [
        {
          "value": "outline",
          "label": "t:global.text.button_style_options.outline"
        },
        {
          "value": "solid",
          "label": "t:global.text.button_style_options.solid"
        },
        {
          "value": "link",
          "label": "t:global.text.button_style_options.link"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:global.colors.background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:global.text.text"
    },
    {
      "type": "range",
      "min": 1,
      "max": 8,
      "step": 1,
      "id": "columns",
      "label": "Columns",
      "default": 5
    },
    {
      "type": "range",
      "min": 1,
      "max": 8,
      "step": 1,
      "id": "columns_mobile",
      "label": "Columns mobile",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG hover icons",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "footer",
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
