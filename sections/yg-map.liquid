            </svg>
            {% for dot in dots %}
              <yg-animation-item
                class="yg-dot"
                data-index="{{ forloop.index0 }}"
                style="--top: {{ dot.settings.top -}}%;--left: {{ dot.settings.left -}}%"
              >
                {% render 'yg-image',
                  img: dot.settings.icon,
                  img_class: 'yg-dot-icon',
                  show_placeholder: false,
                  aspect_ratio: '1'
                %}
                <div class="yg-dot-title">{{ dot.settings.text }}</div>
              </yg-animation-item>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.mobile_style == 'style-1' %}
          {% if dots.size > 0 %}
            <div class="yg-dots-list">
              {% for dot in dots %}
                <yg-animation-item
                  class="yg-map-button yg-dot-button"
                  data-index="{{ forloop.index0 }}"
                  data-class="{{ dot.settings.continent }}"
                >
                  <div class="yg-dot-title">{{ dot.settings.bottom_text | default: dot.settings.text }}</div>
                </yg-animation-item>
              {% endfor %}
            </div>
          {% endif %}
        {% else %}
          {% liquid
            assign show_continent = false
            assign container_num = 0

            if continent_block != blank
              for i in (1..6)
                assign continent_handle = 'continent_' | append: i

                if continent_block.settings[continent_handle] != blank
                  assign show_continent = true
                  assign container_num = container_num | plus: 1
                endif
              endfor
            endif

            assign container_num = container_num | modulo: 2
          %}

          {% if show_continent %}
            <div class="map-button-list {% unless container_num == 0 %} singular {% endunless %}">
              {% for i in (1..6) %}
                {% liquid
                  assign continent_handle = 'continent_' | append: i
                  assign continent_content_handle = 'continent_content_' | append: i
                  assign continent = continent_block.settings[continent_handle]
                  assign continent_content = continent_block.settings[continent_content_handle]
                %}

                {% if continent != blank %}
                  <yg-animation-item class="yg-map-button" data-class="{{ continent_handle }}">
                    <div class="yg-continent-title">{{ continent }}</div>
                    <div class="yg-continent-content">{{ continent_content }}</div>
                  </yg-animation-item>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}

        {% if data_list.size > 0 %}
          <div class="container data-blocks" style="--col: {{ data_list.size }};">
            {% for data in data_list %}
              <yg-animation-item class="yg-text-rows-item">
                {% if data.settings.title != blank %}
                  <div
                    class="yg-text-rows-title"
                    style="--font-size: {{ data.settings.title_size | divided_by: 16.0 | append: 'rem' }};--font-size-mobile: {{ data.settings.title_size_mobile | divided_by: 16.0 | append: 'rem' }}"
                  >
                    {{ data.settings.title }}
                  </div>
                {% endif %}
                {% if data.settings.content != blank %}
                  <div class="yg-text-rows-content">
                    {{ data.settings.content }}
                  </div>
                {% endif %}
              </yg-animation-item>
              {% unless forloop.last %}
                {% comment %} <div class="yg-line"></div> {% endcomment %}
              {% endunless %}
            {% endfor %}
          </div>
        {% endif %}
      </yg-map>
    </div>
  </div>
</div>

