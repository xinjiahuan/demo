<style>
  #shopify-section-{{ section.id }} h2{
    letter-spacing: -0.56px;
  }
  #shopify-section-{{ section.id }} .max-w-sm p {
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .yg-map {
    width: 100%;
    height: auto;
    -webkit-mask-image: url('https://cdn.shopify.com/s/files/1/0928/8882/6153/files/1_1_e7dde348-82fe-4e5c-ab25-91c45664017d.png?v=1753254731');
    -webkit-mask-size: 100% 100%;
    mask-image: url('https://cdn.shopify.com/s/files/1/0928/8882/6153/files/1_1_e7dde348-82fe-4e5c-ab25-91c45664017d.png?v=1753254731') ;
    mask-size: 100% 100%;
  }

  #shopify-section-{{ section.id }} .yg-map-path {
    transition: fill 0.3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-map-path:hover {
    fill: #D68A0A;
  }

  #shopify-section-{{ section.id }} .section-content {
    display: block;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .yg-dot {
    position: absolute;
    top: var(--top);
    left: var(--left);
    display: flex;
    align-items: center;
    width: fit-content;
    padding: 4px 14px 4px 4px;
    border-radius: 50px;
    background-color: #2B2A29;
    border: 1px solid #2B2A29;
    color: #E8E4DA;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.32px;
    pointer-events: none;
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-dot-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .yg-dot .yg-dot-title {
    margin-left: 8px;
  }

  #shopify-section-{{ section.id }} .data-blocks {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    max-width: 1240px;
    margin: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(var(--col), 1fr);
    /* padding-block: var(--blocks-padding-block, 40px); */
    gap: 60px;
  }

  #shopify-section-{{ section.id }} .data-blocks .yg-text-rows-item:not(:last-child) {
    padding-right: 60px;
    border-right: 1px solid rgba(0,0,0,0.1);
  }

  #shopify-section-{{ section.id }} .data-blocks .yg-line {
    width: 1px;
    height: 90%;
    background-color: #000;
    opacity: 0.1;
  }

  #shopify-section-{{ section.id }} .yg-text-rows-title {
    font-size: var(--font-size);
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .yg-text-rows-content {
    font-size: var(--block-content-size, 14px);
    line-height: 1.6;
    font-weight: 500;
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .map-button-list,
  #shopify-section-{{ section.id }} .yg-dots-list {
    display: none;
  }

  @media(max-width: 980px) {
    #shopify-section-{{ section.id }} {
      --col: 1;
      --title-size: 28px;
      --title-line-height: 1.15em;
      --title-letter-spacing: -.56px;
      --title-margin-bottom: 24px;
      --content-size: 14px;
      --button-margin-top: 36px;
      --block-content-size: 13px;
    }
    #shopify-section-{{ section.id }} .yg-map-path.active {
      fill: #D68A0A;
    }

    #shopify-section-{{ section.id }} .yg-dot:not(.active) {
      color: #2B2A29;
      background-color: transparent;
    }

    #shopify-section-{{ section.id }} .yg-dots-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .yg-dots-list .yg-dot-button {
      font-size: 12px;
      color: #2B2A29;
      border: 1px solid #2B2A29;
      padding: 4px 8px;
      border-radius: 24px;
      text-align: center;
      min-width: 60px;
      white-space: nowrap;
      transition: color 0.3s ease-in-out, background 0.3s ease-in-out;
    }

    #shopify-section-{{ section.id }} .yg-dots-list .yg-dot-button.active {
      background: #2B2A29;
      color: #E8E4DA;
    }

    #shopify-section-{{ section.id }} .map-button-list {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
      margin-top: 24px;
      margin-bottom: 48px;
    }

    #shopify-section-{{ section.id }} .map-button-list.singular .yg-map-button:nth-of-type(n + 3) {
      grid-column: 2 span;
    }

    #shopify-section-{{ section.id }} .map-button-list .yg-map-button {
      display: flex;
      padding: 16px 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      border-radius: 4px;
      border: 1px solid rgba(0, 0, 0, 0.10);
      grid-column: 3 span;
    }

    #shopify-section-{{ section.id }} .map-button-list .yg-map-button .yg-continent-title {
      color: #000;
      font-size: 15px;
      font-style: normal;
      font-weight: 600;
      line-height: 115%;
      letter-spacing: -0.3px;
    }

    #shopify-section-{{ section.id }} .map-button-list .yg-map-button .yg-continent-content {
      display: flex;
      gap: 4px;
      align-items: center;
      flex-wrap: wrap;
    }

    #shopify-section-{{ section.id }} .map-button-list .yg-map-button .yg-continent-content p {
      display: flex;
      padding: 4px 8px;
      justify-content: center;
      align-items: center;
      color: #2B2A29;
      border-radius: 24px;
      border: 1px solid #2B2A29;
      font-size: 12px;
      font-weight: 600;
      line-height: normal;
      letter-spacing: -0.24px;
      transition: color 0.3s ease-in-out, background 0.3s ease-in-out;
    }

    #shopify-section-{{ section.id }} .map-button-list .yg-map-button.active {
      border-color: #2B2A29;
    }
    #shopify-section-{{ section.id }} .map-button-list .yg-map-button.active .yg-continent-content p {
      background: #2B2A29;
      color: #E8E4DA;
    }

    #shopify-section-{{ section.id }} .yg-map-path:hover {
      color: #f3e4b9;
    }

    #shopify-section-{{ section.id }} .data-blocks {
      position: static;
      overflow-x: auto;
      width: auto;
      gap: 12px;
      transform: none;
      grid-template-columns: repeat(var(--col), var(--col-width, 35%));
      margin-inline: -20px;
      padding-inline: max(var(--container-gutter-context),50% - var(--container-max-width) / 2);
      -ms-overflow-style: none;     /* IE 和 Edge */
      scrollbar-width: none;        /* Firefox */
    }

    #shopify-section-{{ section.id }} .yg-text-rows-title {
      font-size: var(--font-size-mobile);
    }

    #shopify-section-{{ section.id }} .data-blocks .yg-text-rows-item:not(:last-child) {
      padding-right: 0;
      border-right: none;
    }

    #shopify-section-{{ section.id }} .yg-map-container {
      overflow: hidden;
      scrollbar-width: none;
      width: 100%;
      aspect-ratio: 4/3;
      mask: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    }

    #shopify-section-{{ section.id }} .scroll-container {
      position: relative;
      z-index: 1;
      min-width: 900px;
    }
  }

  @media(max-width: 600px) {
    #shopify-section-{{ section.id }} .data-blocks {
      grid-template-columns: repeat(var(--col), var(--col-width, 60%));
    }

    #shopify-section-{{ section.id }} .yg-map-container {
      aspect-ratio: 4/3;
    }

    #shopify-section-{{ section.id }} .map-button-list {
      grid-template-columns: repeat(2, 1fr);
    }
    #shopify-section-{{ section.id }} .map-button-list.singular .yg-map-button:first-child {
      grid-column: 2 span;
    }

    #shopify-section-{{ section.id }} .map-button-list.singular .yg-map-button:nth-of-type(n + 2) {
      grid-column: 1 span;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}

  <div class="container section-spacing">
    <div class="section-stack">
      {%- if section.settings.title != blank
        or section.settings.heading != blank
        or section.settings.content != blank
      -%}
        <yg-animation-item class="section-header">
          <div class="prose prose-justify-{{ alignment }}">
            <div class="max-w-lg">
              {%- render 'subheading', content: section.settings.subheading -%}
              {%- render 'heading',
                content: section.settings.title,
                balance_text: true,
                style: section.settings.heading_tag,
                html_tag: 'h2'
              -%}
            </div>

            {%- if section.settings.content != blank -%}
              <div class="max-w-sm">
                {{- section.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </yg-animation-item>
      {%- endif -%}

      {% assign dots = section.blocks | where: 'type', 'dot' %}
      {% assign data_list = section.blocks | where: 'type', 'data' %}
      {% assign continent_block = section.blocks | where: 'type', 'continent' | first %}
