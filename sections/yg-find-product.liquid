<style>
  #shopify-section-{{ section.id }} {
  }

  #shopify-section-{{ section.id }} .section-spacing {
    {% if section.settings.enable_custom_padding %}
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .yg-section-body {
    display: flex;
    gap: 48px 15px;
  }

  #shopify-section-{{ section.id }} .yg-section-body .yg-item.active {
    flex: 3;
  }

  #shopify-section-{{ section.id }} .yg-section-body .yg-item {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr calc(2em * 1.4);
    gap: 24px;
    font-size: 15px;
    font-weight: 400;
    line-height: 140%; /* 21px */
    letter-spacing: -0.3px;
    transition: flex 0.3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-section-body .yg-item .yg-image-box {
    aspect-ratio: auto;
    border-radius: 12px;
    overflow: hidden;
    height: var(--image-height, auto);
  }

  #shopify-section-{{ section.id }} .yg-section-body .yg-item-content {
    display: flex;
    gap: 16px;
    text-align: left;
    align-items: center;
    color: rgba(33, 33, 33, 0.70);
  }

  #shopify-section-{{ section.id }} .yg-section-body .yg-item-content .yg-item-title {
    color: #212121;
    font-size: 24px;
    font-weight: 600;
    line-height: 120%; /* 28.8px */
    letter-spacing: -0.24px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .yg-item .yg-item-description {
    opacity: 0;
    transition: opacity 0.1s ease-in-out;
  }

  #shopify-section-{{ section.id }} .yg-item.active .yg-item-description {
    opacity: 1;
    transition: opacity 0.3s 0.3s ease-in-out;
  }

  @media (max-width: 999px) {
    #shopify-section-{{ section.id }} .section-spacing {
      {% if section.settings.enable_custom_padding %}
        padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .yg-section-body {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .yg-section-body .yg-item {
      grid-template-rows: auto;
    }

    #shopify-section-{{ section.id }} .yg-item .yg-item-description {
      opacity: 1;
    }
  }

  @media (max-width: 550px) {
    #shopify-section-{{ section.id }} .yg-section-body .yg-item {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .yg-section-body .yg-item-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    #shopify-section-{{ section.id }} .yg-section-body .yg-item-content .yg-item-title {
      font-size: 18px;
      line-height: 120%; /* 21.6px */
      letter-spacing: -0.18px;
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}

  <div class="container section-spacing">
    <div class="section-stack">
      {%- if section.settings.title != blank
        or section.settings.heading != blank
        or section.settings.content != blank
      -%}
        <div class="section-header">
          <div class="prose prose-justify-{{ alignment }}">
            <div class="max-w-lg">
              {%- render 'subheading', content: section.settings.subheading -%}
              {%- render 'heading',
                content: section.settings.title,
                balance_text: true,
                style: section.settings.heading_tag,
                html_tag: 'h2'
              -%}
            </div>

            {%- if section.settings.content != blank -%}
              <div class="max-w-sm">
                {{- section.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
      {% if section.blocks.size > 0 %}
        <yg-find-product class="yg-section-body">
          {% for block in section.blocks %}
            <div
              class="yg-item {% if forloop.first %}active{% endif %}"
            >
              {% render 'yg-image', img: block.settings.image, show_placeholder: true %}
              <div class="yg-item-content">
                <div class="yg-item-title">{{ block.settings.title }}</div>
                <div class="yg-item-description">{{ block.settings.content }}</div>
              </div>
            </div>
          {% endfor %}
        </yg-find-product>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YG Find Product",
  "class": "shopify-section--yg-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_padding",
      "label": "Enable custom padding",
      "default": false
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 0
    },
    {
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG Find Product"
    }
  ]
}
{% endschema %}
