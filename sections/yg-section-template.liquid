<style>

</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
	{%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}
	
	<div class="container section-spacing">
		<div class="section-stack">
			{%- if section.settings.title != blank or section.settings.heading != blank or section.settings.content != blank -%}
				<div class="section-header">
					<div class="prose prose-justify-{{ alignment }}">
						<div class="max-w-lg">
							{%- render 'subheading', content: section.settings.subheading -%}
							{%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_tag, html_tag: section.settings.html_tag -%}
						</div>
						
						{%- if section.settings.content != blank -%}
							<div class="max-w-sm">
								{{- section.settings.content -}}
							</div>
						{%- endif -%}
					</div>
				</div>
			{%- endif -%}
			{% comment %}以下是示例, yg-slide只是示例轮播，弹窗及图片等为公共资源需要引用，轮播名称不要与当前一致{% endcomment %}
			<yg-slide class="swiper yg-slide">
				<div class="swiper-wrapper">
					{%- for block in section.blocks -%}
						<div class="swiper-slide relative flex align-self-center justify-self-center">
							{% comment %} 引入图片 {% endcomment %}
							{% render 'yg-image',
								img: section.settings.img,
								img_mobile: section.settings.img_mobile,
								img_class: "yg-featured-image",
								show_placeholder: true,
								is_lazy: false
							%}
							{% comment %}公共弹窗,类名可不引用相同{% endcomment %}
							<yg-open-popup class="yg-slide-btn">
								{% comment %} 按钮 {% endcomment %}
								{{ button }}
								{% comment %}引入按钮{% endcomment %}
								{%- render 'button',
									content: section.settings.text,
									href: section.settings.url,
									style: section.settings.style,
									background: section.settings.background,
									text_color: section.settings.text_color,
									external: section.settings.open_in_new_tab,
									block: section
								-%}
								{% comment %}template 放置弹窗内容{% endcomment %}
								<template>
									{% comment %} 引入图片 {% endcomment %}
									{% render 'yg-image',
										img: section.settings.img,
										img_mobile: section.settings.img_mobile,
										img_class: "yg-featured-image",
										show_placeholder: true,
										is_lazy: false
									%}
								</template>
							</yg-open-popup>
						</div>
					{%- endfor -%}
				</div>
				
				<div class="yg-slide-navigation flex gap-2">
					<button class="button yg-slide-prev" type="button" is="next-button">
					
					</button>
					{% comment %}若为数字指示器，添加yg-number-pagination{% endcomment %}
					{% comment %}<div class="yg-slide-pagination yg-number-pagination"></div>{% endcomment %}
					
					{% comment %}若为普通指示器，则不需要添加yg-number-pagination{% endcomment %}
					<div class="yg-slide-pagination"></div>
					<button class="button yg-slide-next " type="button" is="next-button">
					
					</button>
				</div>
			</yg-slide>
		</div>
	</div>
</div>


{% schema %}
{
  "name": "YG section template",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Text with icons"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "h7",
          "label": "H7"
        },
        {
          "value": "p",
          "label": "P"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:global.text.text",
          "default": "Button text"
        },
        {
          "type": "textarea",
          "id": "button_icon",
          "label": "Button icon"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:global.text.link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "t:global.text.open_in_new_tab",
          "default": false
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:global.text.style",
          "options": [
            {
              "value": "outline",
              "label": "t:global.text.button_style_options.outline"
            },
            {
              "value": "solid",
              "label": "t:global.text.button_style_options.solid"
            },
            {
              "value": "link",
              "label": "t:global.text.button_style_options.link"
            }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "background",
          "label": "t:global.colors.background"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:global.text.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG section template",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "footer",
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
