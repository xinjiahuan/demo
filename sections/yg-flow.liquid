<style>
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} {
      --block-title-size: 20px;
      --block-content-size: 14px;
      --block-content-margin-top: 8px;
    }
  }

  #shopify-section-{{ section.id }} {
    --swiper-pagination-bullet-border-radius: 30px;
    --swiper-pagination-bullet-inactive-color: #212121;
    --swiper-pagination-color: #212121;
    --swiper-pagination-bullet-horizontal-gap: 5px;
    --swiper-pagination-bullet-inactive-opacity: .5;

    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .yg-section-main {
    display: flex;
    flex-wrap: wrap;
    gap: 60px 24px;
  }

  #shopify-section-{{ section.id }} .yg-section-main .section-header {
    width: calc(40% - (24px * 2 / 3));
    padding-right: 10%;
  }

  #shopify-section-{{ section.id }} .section-header p {
    margin-block: 0;
  }

  #shopify-section-{{ section.id }} .section-header .max-w-sm {
    margin-top: 16px;
    opacity: 0.6;
    font-size: var(--subheading-font-size);
  }

  #shopify-section-{{ section.id }} .yg-section-main .yg-block {
    width: calc(30% - (24px * 2 / 3));
    height: auto;
  }

  #shopify-section-{{ section.id }} .yg-block {
    display: flex;
    align-items: start;
    gap: 20px;
    flex-direction: column;
    transition: opacity .8s var(--transition-delay) ease, transform .8s var(--transition-delay) ease;
  }

  #shopify-section-{{ section.id }} .yg-block-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    width: 100%;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .yg-top-number {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #FFC000;
    color: #212121;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #FFC000;
    font-size: 20px;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .yg-block-title {
    font-size: var(--block-title-size, 22px);
    color: #212121;
    line-height: 1.2em;
    letter-spacing: -.44px;
  }

  #shopify-section-{{ section.id }} .yg-block-content {
    margin-top: var(--block-content-margin-top, 12px);
    opacity: 0.6;
    font-size: var(--block-content-size, 16px);
    line-height: 1.4em;
    letter-spacing: -.33px;
  }

  #shopify-section-{{ section.id }} .yg-block-image {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .yg-absolute-text {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 12px 16px;
    color: #fff;
    font-size: var(--block-image-text-size, 24px);
    line-height: 1.2em;
    letter-spacing: -.48px;
  }

  #shopify-section-{{ section.id }} .yg-section-main .yg-block:nth-child(odd)  .yg-top-number {
    background: transparent;
  }

  #shopify-section-{{ section.id }} .yg-block-top hr {
    flex: 1;
    width: calc(100% - 48px - 16px);
    height: 1px;
    background-color: rgba(33, 33, 33, 0.10);
  }

  #shopify-section-{{ section.id }} .yg-section-main .yg-block:nth-of-type(n+4) .yg-block-top hr {
    position: absolute;
    right: calc(100% + 24px);
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper {
    display: block;
    width: 100%;
    height: fit-content;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper .yg-block {
    opacity: 1;
    transition: none;
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper .yg-top-title {
    font-size: 22px;
    color: #212121;
    line-height: 1.2em;
    letter-spacing: -.44px;
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper .yg-content-info {
    order: 1;
  }

  #shopify-section-{{ section.id }} .yg-blocks-swiper .yg-block-image {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .swiper-pagination {
    position: static;
    margin-top: 50px;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet {
    transition: width .3s ease-in-out;
  }

  #shopify-section-{{ section.id }} .swiper-pagination-bullet-active {
    width: 46px;
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  {%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}

  <div class="container section-spacing">
    {% capture blocks_main %}
      {% for block in section.blocks %}
        <yg-animation-item  class="yg-block swiper-slide" style="--transition-delay: {{- forloop.index | times: 0.3 -}}s;">
          <div class="yg-block-top">
            <div class="yg-top-number">{% if forloop.index < 10 %} {{ '0' | append: forloop.index }} {% else %} {{ forloop.index }} {% endif %}</div>
              {% if block.settings.text_with_image != blank %} 
                <div class="yg-top-title hide-pc">{{ block.settings.text_with_image }}</div>
              {% endif %}
            <hr>
          </div>
          <div class="yg-content-info">
            <div class="yg-block-title">{{ block.settings.title }}</div>
            <div class="yg-block-content">{{ block.settings.content }}</div>
          </div> 
          <div class="yg-block-image">
            {% render 'yg-image', img: block.settings.image, show_placeholder: true %}
            {% if block.settings.text_with_image != blank %} 
              <div class="yg-absolute-text hide-mobile">{{ block.settings.text_with_image }}</div>
            {% endif %}
          </div>
        </yg-animation-item >
      {% endfor %}
    {% endcapture %}
    <div class="section-stack">
      {%- if section.settings.title != blank
        or section.settings.heading != blank
        or section.settings.content != blank
      -%}
        <yg-animation-item class="section-header hide-pc">
          <div class="prose prose-justify-{{ alignment }}">
            <div class="max-w-lg">
              {%- render 'subheading', content: section.settings.subheading -%}
              {%- render 'heading',
                content: section.settings.title,
                balance_text: true,
                style: section.settings.heading_tag,
                html_tag: 'h2'
              -%}
            </div>

            {%- if section.settings.content != blank -%}
              <div class="max-w-sm">
                {{- section.settings.content -}}
              </div>
            {%- endif -%}
          </div>
        </yg-animation-item>
      {%- endif -%}
      <yg-swiper
        class="swiper yg-blocks-swiper hide-pc"
        data-breakpoints="260:1.05-20,550:1.6-20"
        data-pagination="true"
      >
        <div class="swiper-wrapper">
          {{ blocks_main }}
        </div>
        <div class="swiper-pagination"></div>
      </yg-swiper>

      <div class="yg-section-main hide-mobile">
        {%- if section.settings.title != blank
          or section.settings.heading != blank
          or section.settings.content != blank
        -%}
          <yg-animation-item class="section-header">
            <div class="prose prose-justify-{{ alignment }}">
              <div class="max-w-lg">
                {%- render 'subheading', content: section.settings.subheading -%}
                {%- render 'heading',
                  content: section.settings.title,
                  balance_text: true,
                  style: section.settings.heading_tag,
                  html_tag: 'h2'
                -%}
              </div>

              {%- if section.settings.content != blank -%}
                <div class="max-w-sm">
                  {{- section.settings.content -}}
                </div>
              {%- endif -%}
            </div>
          </yg-animation-item>
        {%- endif -%}

        {{ blocks_main }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YG flow",
  "class": "shopify-section--yg-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "t:global.text.alignment",
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
        },
        {
          "type": "inline_richtext",
          "id": "text_with_image",
          "label": "Text with image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG flow"
    }
  ]
}
{% endschema %}
