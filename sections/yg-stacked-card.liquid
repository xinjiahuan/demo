<style>
  #shopify-section-{{ section.id }} .yg-stacked-slide-thumbs {
    margin-block-end: 2.5rem;
  }

  #shopify-section-{{ section.id }} .yg-stacked-thumb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    transition: opacity .8s ease, transform .8s ease;
  }

  #shopify-section-{{ section.id }} .yg-stack-slide-content {
    font-size: 0.875rem;
    line-height: 1.4;
    opacity: 0.7;
    text-align: center;
  }

  @media (min-width: 700px) {
    #shopify-section-{{ section.id }} .yg-stack-thumbs-wrapper {
      display: flex;
    }

    #shopify-section-{{ section.id }} .yg-stacked-thumb-item {
      display: none;
    }

    #shopify-section-{{ section.id }} .yg-stacked-thumb-item.active {
      display: flex;
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-container {
      padding-block: 3.125rem;
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      transform: translateX(14%);
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item {
      flex: 1;
      box-shadow: 197.1px 117.9px 63.9px 0px rgba(102, 102, 102, 0.00),
      126px 75.6px 58.5px 0px rgba(102, 102, 102, 0.01),
      71.1px 42.3px 49.5px 0px rgba(102, 102, 102, 0.05),
      31.5px 18.9px 36.9px 0px rgba(102, 102, 102, 0.09),
      8.1px 4.5px 19.8px 0px rgba(102, 102, 102, 0.10);
      border-radius: 1.125rem;
      overflow: hidden;
      transition: all ease-in-out .3s;
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item:nth-child(1) {
      z-index: 1;
      transform: translateX(0%) rotate3d(8, 5, 6, 315deg) scale(var(--item-scale, 1));
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item:nth-child(2) {
      z-index: 2;
      transform: translateX(-40%) rotate3d(8, 5, 6, 315deg) scale(var(--item-scale, 1));
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item:nth-child(3) {
      z-index: 3;
      transform: translateX(-80%) rotate3d(8, 5, 6, 315deg) scale(var(--item-scale, 1));
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item:nth-child(4) {
      z-index: 4;
      transform: translateX(-120%) rotate3d(8, 5, 6, 315deg) scale(var(--item-scale, 1));
    }

    #shopify-section-{{ section.id }} .yg-stacked-slide-item.active {
      z-index: 9 !important;
      --item-scale: 1.05;
    }

    #shopify-section-{{ section.id }}  .yg-stacked-slide-item.overlay {
      filter: contrast(0.5);
    }

    #shopify-section-{{ section.id }} .yg-stacked-thumb-item.active {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 699px) {
    #shopify-section-{{ section.id }} .swiper-slide yg-animation-item {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
	{%- assign alignment = section.settings.text_alignment | replace: 'left', 'start' | replace: 'right', 'end' -%}
	
	<div class="container section-spacing">
		<yg-stacked-slide>
			<yg-animation-item class="yg-stacked-slide-thumbs swiper">
				<div class="swiper-wrapper yg-stack-thumbs-wrapper">
					{%- for block in section.blocks -%}
						<div class="swiper-slide yg-stacked-thumb-item{% if forloop.first %} active{% endif %}">
							{% if block.settings.title != blank %}
								<div class="yg-stack-slide-title h4">{{ block.settings.title }}</div>
							{% endif %}
							{% if block.settings.content != blank %}
								<div class="yg-stack-slide-content">{{ block.settings.content }}</div>
							{% endif %}
						</div>
					{%- endfor -%}
				</div>
			</yg-animation-item>
			
			<div class="yg-stacked-slide-container swiper">
				<div class="swiper-wrapper yg-stacked-slide-wrapper">
					{%- for block in section.blocks -%}
						<div class="swiper-slide yg-stacked-slide-item">
							<yg-animation-item>
								{% render 'yg-image',
									img: block.settings.image,
									img_mobile: block.settings.image_mobile,
									img_class: "yg-featured-image",
									show_placeholder: true,
									is_lazy: false
								%}
							</yg-animation-item>
						</div>
					{%- endfor -%}
				</div>
			</div>
		</yg-stacked-slide>
	</div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    class YGStackedSlide extends HTMLElement {
      constructor() {
        super()
        this.swiperInstance = null
        this.handleResize = this.handleResize.bind(this)
        this.handleItemHover = this.handleItemHover.bind(this)
        this.currentActiveItem = null
      }

      get items() {
        return this.querySelectorAll('.yg-stacked-slide-item')
      }

      get thumbs() {
        return this.querySelectorAll('.yg-stacked-thumb-item')
      }

      connectedCallback() {
        this.handleResize()
        window.addEventListener('resize', this.handleResize)
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.handleResize)
        this.destroySwiper()
        this.destroyThumbSwiper()
        this.removeHoverListeners()
      }

      initSwiper() {
        if (this.swiperInstance) return

        const galleryContainer = this.querySelector(".yg-stacked-slide-container")
        const thumbContainer = this.querySelector(".yg-stacked-slide-thumbs")

        this.thumbSwiperInstance = new Swiper(thumbContainer, {
          slidesPerView: 1,
          spaceBetween: 16,
          watchSlidesProgress: true,
          slideToClickedSlide: true,
          effect: 'fade',
          on: {
            slideChange: () => {
              const activeIndex = this.thumbSwiperInstance.realIndex
              this.swiperInstance.slideTo(activeIndex)
            },
          },
        })

        this.swiperInstance = new Swiper(galleryContainer, {
          spaceBetween: 16,
          slidesPerView: 1.3,
          thumbs: {
            swiper: this.thumbSwiperInstance,
          },
          pagination: {
            el: '.yg-gallery-pagination',
            clickable: true,
          },
          breakpoints: {
            220: {
              slidesPerView: 1.3,
              spaceBetween: 16,
            },
          },
        })
      }

      destroySwiper() {
        if (this.swiperInstance) {
          this.swiperInstance.destroy(true, true)
          this.swiperInstance = null
        }
      }

      destroyThumbSwiper() {
        if (this.thumbSwiperInstance) {
          this.thumbSwiperInstance.destroy(true, true)
          this.thumbSwiperInstance = null
        }
      }

      handleResize() {
        const width = window.innerWidth
        if (width < 700) {
          this.initSwiper()
          this.removeHoverListeners()
          this.clearActiveItems()
        } else {
          this.destroySwiper()
          this.destroyThumbSwiper()
          this.addHoverListeners()
        }
      }

      addHoverListeners() {
        this.items.forEach(item => {
          item.removeEventListener('mouseenter', this.handleItemHover)
          item.addEventListener('mouseenter', this.handleItemHover)
          item.removeEventListener('mouseleave', this.handleItemHover)
          item.addEventListener('mouseleave', this.handleItemHover)
        })
      }

      removeHoverListeners() {
        this.items.forEach(item => {
          item.removeEventListener('mouseenter', this.handleItemHover)
          item.removeEventListener('mouseleave', this.handleItemHover)
        })
      }

      clearActiveItems() {
        this.items.forEach(item => item.classList.remove('active'))
        this.thumbs.forEach(thumb => thumb.classList.remove('active'))
        this.currentActiveItem = null
      }

      handleItemHover(e) {
        const type = e.type;
        const target = e.currentTarget;
        const index = [...this.items].indexOf(target);

        if (type === 'mouseenter') {
          this.items.forEach(item => {
            item.classList.remove('active', 'overlay');
          });
          this.thumbs.forEach(thumb => thumb.classList.remove('active'));

          target.classList.add('active');
          if (this.thumbs[index]) {
            this.thumbs[index].classList.add('active');
          }

          this.items.forEach(item => {
            if (item !== target) {
              item.classList.add('overlay');
            }
          });

          this.currentActiveItem = target;

        } else if (type === 'mouseleave') {
          setTimeout(() => {
            // 查询是否有任何 .yg-stacked-slide-item 仍在 hover
            const stillHover = [...this.items].some(item => item.matches(':hover'));

            if (!stillHover) {
              // 没有任意项被 hover，保持当前的状态，不做改动
              // 所以这里不移除 active 和 overlay，保持 last hover 状态

              // 这里可以直接 return，不做任何事
              return;
            }
            // 如果有项仍被 hover，不做处理，等待下一次事件触发
          }, 10);
        }
      }
    }

    if (!window.customElements.get('yg-stacked-slide')) {
      window.customElements.define('yg-stacked-slide', YGStackedSlide)
    }
  });
</script>

{% schema %}
{
  "name": "YG stacked card",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.heading",
          "default": "Text with icons"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use this section to build trust with your customers, or showcase product features with text and icons.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YG stacked card",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "footer",
      "header",
      "custom.overlay"
    ]
  }
}
{% endschema %}
